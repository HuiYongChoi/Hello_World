# scripts/deploy-aws.sh 용 접속 정보.
#
#   cp .env.deploy.example .env.deploy
#
# .env.deploy 는 gitignore 처리되어 커밋되지 않습니다.
# 이 예시 파일에는 실제 값을 절대 넣지 마세요 — 저장소가 공개입니다.

# 서버 접속 대상 (사용자@호스트)
DEPLOY_HOST=bitnami@YOUR.SERVER.IP

# SSH 개인키 경로. 경로에 공백이 있으면 따옴표로 감싸세요.
DEPLOY_KEY="/Users/사용자명/Desktop/키파일"

# 웹 루트. Bitnami 스택에 따라 /opt/bitnami/apache/htdocs 인 경우도 있습니다.
DEPLOY_WEB_ROOT=/var/www/html

# 웹 루트 하위 배포 경로 → https://호스트/hyrealty/
DEPLOY_SITE_PATH=hyrealty
